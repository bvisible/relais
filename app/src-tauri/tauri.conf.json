{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relais",
  "version": "0.1.0",
  "identifier": "ai.neoservice.relais",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Relais",
        "width": 400,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "© 2026 Neoservice",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyOEZCOEQwQTQ4QUFGNEUKUldST3I0cWswTGlQY29uTFl1dDQ3bXA3RlJ3M2tnOCtjNHk4a1h6WVlyOHBmUEpHaVU4TyttUFQK",
      "endpoints": [
        "https://github.com/bvisible/relais/releases/latest/download/latest.json"
      ]
    }
  }
}
